# App desktop — sviluppo locale (mai committato, mai nel bundle di produzione)
# La trascrizione in produzione passa SEMPRE dalla Supabase Edge Function (proxy),
# non mettere OPENAI_API_KEY qui né nel bundle Electron distribuito.

# Supabase (per Edge Function /transcribe proxy — anon key ok nel client desktop,
# service_role MAI nel client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TRANSCRIBE_FUNCTION_URL=

# Solo per test locale diretto senza proxy (non usare in distribuzione):
# OPENAI_API_KEY=

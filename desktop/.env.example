# VoiceFlow Desktop — env locale (mai committare il file reale)
# Copia in .env (o .env.local) e riempi.

# Supabase — stesso progetto dedicato del sito web
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Licenza (opzionale in dev — oppure login Supabase)
VITE_LICENSE_KEY=

# Quota free visualizzata in UI (deve matchare il secret FREE_MONTHLY_WORD_LIMIT della Edge Function)
FREE_MONTHLY_WORD_LIMIT=10000

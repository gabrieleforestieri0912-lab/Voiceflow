{
  "name": "voiceflow-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "VoiceFlow Desktop — dettatura vocale push-to-talk per Windows (Electron + TypeScript)",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps || true"
  },
  "dependencies": {
    "electron-store": "^10.0.1"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.1.0",
    "@nut-tree/nut-js": "^4.0.0",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}

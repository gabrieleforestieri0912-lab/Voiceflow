# Sito web — Next.js App Router + Tailwind + Supabase (deploy Vercel, team StackUp)
# Copia in .env.local (mai committare). Placeholder finché il progetto Supabase
# dedicato a VoiceFlow non è creato — NON riusare progetti di altri prodotti.

# Supabase — progetto dedicato, isolato
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo server (route handler / server actions) — MAI esporre al browser
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (test) — placeholder, checkout fuori scope MVP
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# URL pubblico usato per redirect auth/checkout
NEXT_PUBLIC_SITE_URL=http://localhost:3000
